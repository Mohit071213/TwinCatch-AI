# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ZERO-BILL DEVELOPER SHIELD (Recommended default for pre-publishing)
# Keep ALLOW_PAID_GEMINI_VEO="false" so public testers cannot trigger developer-billed Veo video generation.
ALLOW_PAID_GEMINI_VEO="false"
TESTER_GEMINI_HOURLY_LIMIT="18"
TESTER_GEMINI_DAILY_LIMIT="45"

# Optional Developer Owner Passcode (used only if ALLOW_PAID_GEMINI_VEO="true" for personal testing)
OWNER_UNLOCK_TOKEN=""

# Optional Stripe Checkout Pass-Through (required if you want testers to prepay for Gemini Veo renders)
STRIPE_SECRET_KEY=""
